# Gemini free-tier example. Copy to .env.local and fill in the API key locally.
export ALFWORLD_CONFIG_PATH="$PWD/configs/base_config.yaml"
export ALFWORLD_SPLIT="eval_out_of_distribution"
export LLM_PROVIDER="openai_compatible"
export LLM_MODEL="gemini-2.5-flash-lite"
export LLM_API_KEY=""
export LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export LLM_MIN_REQUEST_INTERVAL_SECONDS="4.2"
export LLM_MAX_RETRIES="3"
export LLM_RETRY_BASE_SECONDS="5"
